# Copia este archivo como .env y ajusta los valores.

# URL de la API de ZeroScam, vista desde el NAVEGADOR de quien abre el panel.
# Se incrusta en el build: si la cambias, hay que reconstruir
# (docker compose up -d --build, o npm run build).
#  - API en la misma PC:          http://localhost:3000
#  - API en otra PC de la red:    http://192.168.1.50:3000
#  - API publicada en internet:   https://api.tudominio.com
# En producción debe ser https://; el build falla con http:// salvo para
# localhost o 127.0.0.1 (ver src/lib/security.ts).
# Laboratorio sin TLS: con ALLOW_INSECURE_API_URL=true se acepta http:// hacia
# una IP de la red (el Bearer viaja sin cifrar dentro de esa red).
# ALLOW_INSECURE_API_URL=false
# El backend debe tener este panel en CORS_ORIGINS (por ejemplo
# http://localhost:3001), o el navegador bloqueará las peticiones.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Puerto de la PC donde se abre el panel (http://localhost:3001)
ADMIN_PORT=3001
